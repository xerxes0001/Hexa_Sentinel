# HexaSentinel — On-Device Configuration
# No cloud API keys needed at runtime.
# The Llama 3.2 3B model runs locally on the Hexagon NPU via Qualcomm AI Hub.

# On-device FastAPI backend URL (never changes)
VITE_HEXASENTINEL_API_URL=http://127.0.0.1:8000

# RIPE RIS live BGP feed (public, no key needed)
VITE_RIS_WS_URL=wss://ris-live.ripe.net/v1/ws/
